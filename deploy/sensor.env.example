# Copy to /etc/sensor.env and edit.

# Required: name=MAC (comma-separated for more)
SENSORS=garage=F2:A9:C0:86:55:21

# Web UI
WEB_HOST=0.0.0.0
WEB_PORT=8678

# BLE scan
SCAN_INTERVAL_SECONDS=60
SCAN_TIMEOUT_SECONDS=90
RETENTION_DAYS=730
LOG_LEVEL=INFO

# Local SQLite database
SQLITE_PATH=/var/lib/sensor/sensors.db

# MQTT is optional on native installs
ENABLE_MQTT=false
# MQTT_HOST=127.0.0.1
# MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
