# Copy to .env and replace placeholder values before starting the stack.
# Do not commit .env.

# Mosquitto MQTT
MQTT_USERNAME=sensor
MQTT_PASSWORD=change-me-mqtt
MQTT_PORT=1883

# InfluxDB 2 (init on first start)
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=change-me-influx
INFLUXDB_ORG=home
INFLUXDB_BUCKET=sensors
INFLUXDB_RETENTION=730d
INFLUXDB_TOKEN=change-me-influx-token-use-a-long-random-string
INFLUXDB_PORT=8086

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
GRAFANA_PORT=3000

# BLE collector
SCAN_INTERVAL_SECONDS=900
SCAN_TIMEOUT_SECONDS=60
MQTT_TOPIC_PREFIX=sensors/switchbot
LOG_LEVEL=INFO

# Dockage / single-container: configure meters via env (preferred over sensors.yaml)
# Format: name=AA:BB:CC:DD:EE:FF,name2=11:22:33:44:55:66
# SENSORS=outdoor=AA:BB:CC:DD:EE:FF

# Collector connection targets when not using compose service DNS
# MQTT_HOST=127.0.0.1
# INFLUX_URL=http://127.0.0.1:8086
# INFLUX_ORG=home
# INFLUX_BUCKET=sensors
# INFLUX_TOKEN=change-me-influx-token-use-a-long-random-string

