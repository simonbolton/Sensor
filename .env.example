# Copy to .env for compose, or paste into Dockge env.

# Required: SwitchBot meters (name=MAC,name2=MAC2)
SENSORS=outdoor=AA:BB:CC:DD:EE:FF

# Optional MQTT auth inside the container (leave empty for anonymous LAN broker)
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=sensors/switchbot

# Collector / web
SCAN_INTERVAL_SECONDS=900
SCAN_TIMEOUT_SECONDS=60
RETENTION_DAYS=730
WEB_PORT=8080
LOG_LEVEL=INFO
ENABLE_MQTT=true
